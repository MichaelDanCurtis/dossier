{
  "manifest_version": 3,
  "name": "CareerAI \u2014 LinkedIn workspace",
  "version": "0.3.1",
  "description": "Your private career workspace inside LinkedIn: collect roles, review feed and message excerpts, and draft with AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://careerai.thecurtis.cloud/*"
  ],
  "action": {
    "default_title": "Open CareerAI on LinkedIn",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://careerai.thecurtis.cloud"
  },
  "key": "",
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://www.linkedin.com/*"
  ]
}
