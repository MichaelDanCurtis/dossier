{
  "manifest_version": 3,
  "name": "CareerAI — Save LinkedIn jobs",
  "version": "0.1.0",
  "description": "Review and save the LinkedIn job you are viewing to your private CareerAI account.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://careerai.thecurtis.cloud/*"
  ],
  "action": {
    "default_title": "Save a job to CareerAI",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://careerai.thecurtis.cloud"
  },
  "key": "",
  "icons": {
    "128": "icon.png"
  }
}
