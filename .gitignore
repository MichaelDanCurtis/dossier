.DS_Store
*.pem

# The website, built by site/build.sh
/_site/

# DOSSIER_DATA_DIR in development (backups, temporary downloads)
/data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
